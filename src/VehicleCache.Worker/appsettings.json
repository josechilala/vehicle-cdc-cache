{
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "VehicleTopic": "vehicle_cdc.public.vehicles",
    "PositionTopic": "vehicle_cdc.public.positions",
    "ConsumerGroup": "vehicle-cache-worker",
    "SessionTimeoutMs": 10000,
    "MaxPollIntervalMs": 300000,
    "CommitTimeoutMs": 10000,
    "ExpectedPartitionCount": 3,
    "ReplayBaselineOffset": 0
  },
  "Valkey": {
    "ConnectionString": "localhost:6379",
    "OperationTimeoutMs": 5000,
    "RetryCount": 3,
    "RetryDelayMs": 250
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
